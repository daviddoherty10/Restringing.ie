# Copy to deploy/.env. DO NOT commit deploy/.env.
# Use a long random password with URL-safe characters (or URL-encode special characters in DATABASE_URL).
POSTGRES_USER=restringing
POSTGRES_PASSWORD=replace_with_random_url_safe_password
POSTGRES_DB=restringing
DATABASE_URL=postgres://restringing:replace_with_random_url_safe_password@db:5432/restringing?sslmode=disable

# Local preview: http://localhost:8080
# Production: https://restringing.ie (TLS terminates at Coolify/reverse proxy)
FRONTEND_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Disabled in preview. Configure only after external providers are ready.
AUTH_SMS_PROVIDER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
AUTH_RATE_LIMIT_KEY=
AUTH_ALLOWED_CALLING_CODES=+353,+44
AUTH_TRUSTED_PROXY_CIDRS=
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
