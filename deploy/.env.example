# Copy to deploy/.env. Never commit this file with credentials.
POSTGRES_USER=restringing
POSTGRES_PASSWORD=replace_with_random_url_safe_password
POSTGRES_DB=restringing
DATABASE_URL=postgres://restringing:replace_with_random_url_safe_password@db:5432/restringing?sslmode=disable

# Local tests: preview http://localhost:8080, landing http://localhost:8082
# VPS/Coolify: FRONTEND_ORIGIN MUST be https://preview.restringing.ie
FRONTEND_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080
LANDING_BIND=127.0.0.1
LANDING_PORT=8082

# Keep external integrations disabled during preview unless explicitly tested.
AUTH_SMS_PROVIDER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
AUTH_RATE_LIMIT_KEY=
AUTH_ALLOWED_CALLING_CODES=+353,+44
AUTH_TRUSTED_PROXY_CIDRS=
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Review legal wording, identities and confirmation delivery before activation.
BOOKING_LEGAL_ENFORCEMENT=false
TRADER_VERIFICATION_ENFORCEMENT=false

# Optional error-only telemetry for source builds. For prebuilt images, set GitHub Actions variables before publishing.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_RELEASE=

# Optional transactional SMS; separate from sign-in Verify. Disabled by default.
JOB_SMS_PROVIDER=
JOB_SMS_ACCOUNT_SID=
JOB_SMS_MESSAGING_SERVICE_SID=
JOB_SMS_API_KEY_SID=
JOB_SMS_API_KEY_SECRET=
JOB_SMS_AUTH_TOKEN=

# Optional racket payments to individual stringers (separate from subscription billing).
# Use a restricted Stripe sandbox key with connected-account permissions.
RACKET_PAYMENTS_PROVIDER=
RACKET_STRIPE_KEY=
RACKET_STRIPE_WEBHOOK_SECRET=
