POSTGRES_USER=restringing
POSTGRES_PASSWORD=restringing_dev
POSTGRES_DB=restringing

DATABASE_URL=postgres://restringing:restringing_dev@localhost:5433/restringing?sslmode=disable
API_ADDR=:8081
FRONTEND_ORIGIN=http://localhost:5173

# SMS sign-in stays disabled until the provider is configured. Backend only;
# never put these credentials in VITE_* variables or commit your actual .env.
AUTH_SMS_PROVIDER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Generate once with: openssl rand -hex 32. Share across API replicas.
AUTH_RATE_LIMIT_KEY=
AUTH_ALLOWED_CALLING_CODES=+353,+44
# Optional explicit proxy CIDRs. Otherwise only the TCP peer is used for limits.
AUTH_TRUSTED_PROXY_CIDRS=

# Business subscriptions. Leave disabled for the free tier and cash bookings.
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
